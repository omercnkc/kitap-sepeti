MYSQL_ROOT_PASSWORD=
USER_DB_USER=
USER_DB_PASSWORD=
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
CATALOG_DB_USER=
# CATALOG_DB_PASSWORD: yalnızca harf ve rakam (init script'i parolayı SQL'e tek tırnak içinde gömer).
CATALOG_DB_PASSWORD=
CART_DB_USER=
# CART_DB_PASSWORD: yalnızca harf ve rakam (init script'i parolayı SQL'e tek tırnak içinde gömer).
CART_DB_PASSWORD=
PAYMENT_DB_USER=
# PAYMENT_DB_PASSWORD: yalnızca harf ve rakam (init script'i parolayı SQL'e tek tırnak içinde gömer).
PAYMENT_DB_PASSWORD=
# ORDER_INTERNAL_API_KEY: order-service'in catalog /internal/** uçlarına gönderdiği ham anahtar (rastgele 32 bayt, base64url).
ORDER_INTERNAL_API_KEY=
# Aşağıdaki üç *_INTERNAL_KEY_ORDER_SHA256 için politika aynı: boşsa ya da 64 hex değilse servis açılmaz;
# docker compose da boşken başlamaz.
# CATALOG_INTERNAL_KEY_ORDER_SHA256: aynı anahtarın SHA-256 özeti (64 hex); catalog /internal/** uçları yalnızca bunu bilir.
CATALOG_INTERNAL_KEY_ORDER_SHA256=
# CART_INTERNAL_KEY_ORDER_SHA256: ORDER_INTERNAL_API_KEY'in SHA-256 özeti (hex); cart /internal/** uçları yalnızca bunu bilir.
CART_INTERNAL_KEY_ORDER_SHA256=
# PAYMENT_INTERNAL_KEY_ORDER_SHA256: ORDER_INTERNAL_API_KEY'in SHA-256 özeti (hex); payment /internal/** uçları yalnızca
# bunu bilir. Boşsa ya da 64 hex değilse payment-service açılmaz.
PAYMENT_INTERNAL_KEY_ORDER_SHA256=
# PAYMENT_MOCK_WEBHOOK_SECRET: mock sağlayıcının webhook imza anahtarı (HMAC-SHA256); rastgele, en az 32 karakter
# (ör. 32 bayt base64url = 43 karakter). Yalnızca payment-service kullanır; boşsa ya da kısaysa payment-service açılmaz.
PAYMENT_MOCK_WEBHOOK_SECRET=
