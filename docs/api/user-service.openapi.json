{
  "openapi": "3.1.0",
  "info": {
    "description": "Kullanıcı kaydı, kimlik doğrulama, profil ve adres yönetimi.\n\n**Kimlik doğrulama:** `POST /api/auth/login` (veya `register`) yanıtındaki `accessToken`'ı her istekte `Authorization: Bearer <accessToken>` başlığıyla gönderin. Access token 15 dakika geçerlidir; süresi dolunca `POST /api/auth/refresh` ile yeni bir token çifti alın. Refresh token her kullanımda yenilenir (rotation): yanıttaki yeni refresh token saklanmalı, eskisi artık geçersizdir.\n\n**Hatalar:** Tüm hatalar RFC 9457 ProblemDetail olarak `application/problem+json` ile döner (`Problem` şeması). İstemci hatayı `code` alanına göre ayırt eder; doğrulama hatalarında `errors` dizisi alan bazında mesaj içerir.\n",
    "title": "Kitap Sepeti — User Service API",
    "version": "0.0.1-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "description": "Oturum sahibinin adresleri. Adresi olan kullanıcının tam olarak bir varsayılan adresi vardır.",
      "name": "Addresses"
    },
    {
      "description": "Access token imzasını doğrulamak için açık anahtarlar.",
      "name": "Keys"
    },
    {
      "description": "Oturum sahibinin profili. Kullanıcı token'dan belirlenir.",
      "name": "Profile"
    },
    {
      "description": "Kayıt, giriş ve token yenileme. Token gerektirmez.",
      "name": "Auth"
    }
  ],
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "description": "RS256 açık anahtar(lar)ı. Token başlığındaki `kid` ile eşleşen anahtar seçilir; anahtar değişince `kid` de değişir.",
        "operationId": "getJwks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "keys": [
                    {
                      "kty": "RSA",
                      "e": "AQAB",
                      "use": "sig",
                      "kid": "hN3x...",
                      "alg": "RS256",
                      "n": "0vx7..."
                    }
                  ]
                }
              }
            },
            "description": "Açık anahtar kümesi."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`INTERNAL_ERROR`: beklenmeyen hata; ayrıntı yanıtta yer almaz."
          }
        },
        "security": [],
        "summary": "JWKS",
        "tags": [
          "Keys"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "E-posta ve parola ile token çifti alır.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Giriş başarılı."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`VALIDATION_FAILED` (alan hataları `errors` dizisinde) veya `MALFORMED_REQUEST` (okunamayan JSON)."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "example": {
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Invalid email or password.",
                  "instance": "/api/auth/login",
                  "code": "INVALID_CREDENTIALS"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`INVALID_CREDENTIALS`: e-posta veya parola hatalı (hangisinin hatalı olduğu bilinçli olarak söylenmez)."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`ACCOUNT_SUSPENDED`: hesap askıya alınmış (yalnızca parola doğruysa)."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`INTERNAL_ERROR`: beklenmeyen hata; ayrıntı yanıtta yer almaz."
          }
        },
        "security": [],
        "summary": "Giriş yap",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Refresh token karşılığında yeni bir access + refresh token çifti döner. Her çağrı yeni bir refresh token üretir ve gönderileni iptal eder (rotation); istemci yanıttaki yeni token'ı saklamalıdır. İptal edilmiş (eski) bir refresh token tekrar kullanılırsa token çalınmış sayılır ve kullanıcının tüm oturumları (tüm refresh token'ları) iptal edilir.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Yeni token çifti."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`VALIDATION_FAILED` (alan hataları `errors` dizisinde) veya `MALFORMED_REQUEST` (okunamayan JSON)."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`INVALID_REFRESH_TOKEN`: token bilinmiyor, süresi dolmuş veya iptal edilmiş."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`INTERNAL_ERROR`: beklenmeyen hata; ayrıntı yanıtta yer almaz."
          }
        },
        "security": [],
        "summary": "Token yenile",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
