  "components": {
    "schemas": {
      "AddressResponse": {
        "type": "object",
        "description": "Adres.",
        "properties": {
          "city": {
            "type": "string",
            "example": "İstanbul"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2.",
            "example": "TR"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Oluşturulma zamanı (UTC).",
            "example": "2026-09-29T12:19:33.752772Z"
          },
          "district": {
            "type": "string",
            "description": "Yoksa null.",
            "example": "Kadıköy"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Adres id'si.",
            "example": "01a0ed1b-22f7-7a76-aa96-c8ec0f3b3a4a"
          },
          "isDefault": {
            "type": "boolean",
