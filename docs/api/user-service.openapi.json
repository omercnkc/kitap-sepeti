      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details. İstemci hatayı `code` alanına göre ayırt etmelidir; `title`/`detail` insan içindir ve değişebilir.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Makine tarafından okunacak hata kodu.",
            "enum": [
              "EMAIL_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "INVALID_REFRESH_TOKEN",
              "ACCOUNT_SUSPENDED",
              "RESOURCE_NOT_FOUND",
              "VALIDATION_FAILED",
              "MALFORMED_REQUEST",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "NOT_ACCEPTABLE",
              "UNSUPPORTED_MEDIA_TYPE",
              "CONFLICT",
              "DEFAULT_ADDRESS_REQUIRED",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "INTERNAL_ERROR"
            ],
            "example": "EMAIL_ALREADY_EXISTS"
          },
          "detail": {
            "type": "string",
            "description": "Genel açıklama; kullanıcı verisi içermez.",
            "example": "Email is already registered."
          },
          "errors": {
            "type": "array",
            "description": "Yalnızca `VALIDATION_FAILED`'da: alan bazında hatalar. Gönderilen değer yer almaz.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "İsteğin yolu.",
            "example": "/api/auth/register"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP durum kodu.",
            "example": 409
          },
          "title": {
            "type": "string",
            "description": "HTTP durumunun kısa adı.",
            "example": "Conflict"
          },
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Problem tipi; varsayılan `about:blank` olduğunda yanıtta yer almaz."
          }
        },
        "required": [
          "code",
          "instance",
          "status",
          "title"
        ]
      },
